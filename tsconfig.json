{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "noEmit": true,
        "moduleResolution": "bundler",
        "target": "esnext",
        "module": "esnext",
        "resolveJsonModule": true,
        "lib": [
          "ESNext",
          "DOM"
        ]
    },
    "include": [
        "src/*",
        "src/*/*"
    ]
}